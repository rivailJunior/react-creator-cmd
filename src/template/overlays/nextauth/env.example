## please create an .env file with the following content

WELCOME_MESSAGE="We are here to help you with your Next.js project 🥳"

# Auth.js (NextAuth v5)
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
