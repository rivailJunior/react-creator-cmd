{
  "name": "react-creator-cmd",
  "version": "2.1.1",
  "description": "CLI to bootstrap Next.js 15 projects with React 19, Tailwind v4, testing, AI assistant configs, and modern tooling",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsc && node ./dist/index.js",
    "build": "npx tsc",
    "link-cli": "npm --global unlink . && chmod +x ./dist/index.js && npm link .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "bin": {
    "react-creator": "./dist/index.js"
  },
  "author": "Rivail Pinto",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^0.8.0",
    "figlet": "^1.7.0",
    "log-beautify": "^1.2.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
