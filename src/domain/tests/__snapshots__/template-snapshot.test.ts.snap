  ".github/workflows/main.yml": "name: CI/CD

env:
  WELCOME_MESSAGE: We are here to help you with your Next.js project 🥳

on:
  push:
    branches: ["main", "dev"]
  pull_request:
    branches: ["main", "dev"]

permissions:
  actions: write
  contents: read

jobs:
  lint:
    name: ⬣ ESLint
    runs-on: ubuntu-latest
    steps:
      - name: ⬇️ Checkout repo
        uses: actions/checkout@v4

      - name: ⎔ Setup node
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: 📥 Install deps
        run: npm ci

      - name: 🔬 Lint
        run: npm run lint

  typecheck:
    needs: ["lint"]
    name: ʦ TypeScript
    runs-on: ubuntu-latest
    steps:
      - name: ⬇️ Checkout repo
        uses: actions/checkout@v4

      - name: ⎔ Setup node
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: 📥 Install deps
        run: npm ci

      - name: 🔎 Type check
        run: npx tsc --noEmit

  test:
    needs: ["typecheck"]
    name: 🧪 Unit tests
    runs-on: ubuntu-latest
    steps:
      - name: ⬇️ Checkout repo
        uses: actions/checkout@v4

      - name: ⎔ Setup node
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: 📥 Install deps
        run: npm ci

      - name: Running test
        run: npm run test:unit

  test-e2e:
    needs: ["test"]
    name: 🌲 E2E Cypress
    timeout-minutes: 60
    runs-on: ubuntu-latest
    if: \${{ success() }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install dependencies
        run: npm ci

      - name: Run Cypress tests
        uses: cypress-io/github-action@v6
        with:
          build: npm run build
          start: npm start
          browser: chrome
",
  ".gitignore": "# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
